# 共享 PostgreSQL + Redis 环境变量
#
# 复制为 infra/shared/.env，填入强口令；这个文件不提交。
# 初始化脚本只在 shared_pgdata 卷为空时执行一次。

SHARED_NETWORK=p2-shared

# ---- PostgreSQL 2GB 实例 ----
SHARED_PG_SUPERUSER=postgres
SHARED_PG_SUPERPASSWORD=CHANGE_ME_SUPERUSER
SHARED_PG_PORT=12500
SHARED_PG_MEM_LIMIT=2g
SHARED_PG_CPUS=1.5

# 四个项目的库 owner 口令；留空则跳过该项目
P1_DB_PASSWORD=CHANGE_ME_P1_DB_PASSWORD
P2_DB_PASSWORD=CHANGE_ME_P2_DB_PASSWORD
P3_DB_PASSWORD=
P4_DB_PASSWORD=

# P2 Lite Demo 独立库；不需要 demo 时留空
P2_DEMO_DB_PASSWORD=

# P1 最终稿的 app 角色（Row Level Security 用）；不迁移 P1 可留空
P1_APP_PASSWORD=

# ---- Redis ----
SHARED_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
SHARED_REDIS_PORT=12600
SHARED_REDIS_MEM_LIMIT=256m
SHARED_REDIS_MAXMEMORY=256mb
SHARED_REDIS_CPUS=0.5

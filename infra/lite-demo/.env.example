# P2 Lite Demo 环境变量
#
# 复制为 infra/lite-demo/.env 后填写。.env 不入库，示例文件只保留占位符。
# 这个 demo 必须使用独立库和独立 Redis DB，不要指向正式 Lite 的 db_p2。

# ---- 独立 PostgreSQL ----
DATABASE_URL=postgresql+psycopg://u_p2_demo:CHANGE_ME_DEMO_DB_PASSWORD@shared-postgres:5432/db_p2_demo
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- 独立 Redis DB（P1=0 / P2=1 / P3=2 / P4=3；demo 用 5）----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@shared-redis:6379/5
REDIS_KEY_PREFIX=p2demo:

# ---- LLM ----
EXTERNAL_LLM_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
EXTERNAL_LLM_API_KEY=sk-REPLACE_ME
EXTERNAL_LLM_MODEL=deepseek-v4.1-flash-1017
EXTERNAL_LLM_THINKING=false
EXTERNAL_LLM_TIMEOUT_S=120
LLM_USAGE_POLICY=external_first
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen3-4b

# ---- 安全 ----
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_EXPIRE_HOURS=12
# 独立的 Cookie 名，避免同主机不同端口互相覆盖登录态
SESSION_COOKIE_NAME=p2m_demo_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=false
ADMIN_USERNAMES=demo
ENABLE_DOCS=false
CORS_ORIGINS=http://localhost:12306,http://127.0.0.1:12306

# ---- 演示账号（会写进 demo 前端构建产物，仅用于演示）----
DEMO_USERNAME=demo
DEMO_PASSWORD=P2Demo2026
DEMO_DISPLAY_NAME=演示用户

# ---- 容器端口 ----
DEMO_WEB_PORT=12306
DEMO_API_PORT=12706

# ---- 资源上限 ----
DEMO_BACKEND_MEM_LIMIT=640m
DEMO_FRONTEND_MEM_LIMIT=96m
DEMO_BACKEND_CPUS=1
DEMO_FRONTEND_CPUS=0.5

# ---- 共享网络与构建 ----
SHARED_NETWORK=p2-shared
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

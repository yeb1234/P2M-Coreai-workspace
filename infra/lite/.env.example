# P2 7.2 Lite 专用环境变量
#
# 复制为 infra/lite/.env 后填写。这个文件不要提交；仓库只保留 .env.example。
# 关键边界：
#   database = 共享 PG 的 db_p2，用户 u_p2，不能用 P1/P3/P4 的库
#   Redis  = 共享 Redis 的 DB 1，所有 P2 key 带 p2: 前缀
#   Lite   = 无 pgvector、无视频、无转写、无 worker

# ---- 共享 PostgreSQL ----
# docker 共享网络内的服务名；如果不用共享网络，改成 host.docker.internal:12500
DATABASE_URL=postgresql+psycopg://u_p2:CHANGE_ME_P2_DB_PASSWORD@shared-postgres:5432/db_p2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- 共享 Redis ----
# 必须带 /1；密码按共享 Redis 的 REDIS_PASSWORD 填
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@shared-redis:6379/1
REDIS_KEY_PREFIX=p2:

# ---- LLM ----
# Lite 没有本地 embedding，也不会调 embedding；只配对话模型即可
EXTERNAL_LLM_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
EXTERNAL_LLM_API_KEY=sk-REPLACE_ME
EXTERNAL_LLM_MODEL=deepseek-v4.1-flash-1017
EXTERNAL_LLM_THINKING=false
EXTERNAL_LLM_TIMEOUT_S=120
LLM_USAGE_POLICY=external_first
# Agent 默认走 external；本地 LM Studio 地址仅作为兜底，不参与 Lite 检索
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen3-4b

# ---- 安全 ----
# 长度 >= 32，生产必须替换
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_EXPIRE_HOURS=12
SESSION_COOKIE_NAME=p2m_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 首次建号可临时 true，建完改回 false
ALLOW_REGISTRATION=true
ADMIN_USERNAMES=
ENABLE_DOCS=false
# 必须包含 Lite 实际访问的 origin；云上换成域名
CORS_ORIGINS=http://localhost:12305,http://127.0.0.1:12305

# ---- 容器端口 ----
LITE_WEB_PORT=12305
LITE_API_PORT=12705

# ---- 资源上限（验收时按这里读 docker stats） ----
LITE_BACKEND_MEM_LIMIT=640m
LITE_FRONTEND_MEM_LIMIT=96m
LITE_BACKEND_CPUS=1
LITE_FRONTEND_CPUS=0.5

# ---- 构建 ----
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

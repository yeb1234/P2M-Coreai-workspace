# P2M CoreAI Workspace - 环境变量模板
# 用法：复制为 .env 后按需修改。真实密钥请勿提交到仓库。

# ---------- 数据库 ----------
# 默认走 SQLite（单文件，无需额外服务），首次启动自动建表
DATABASE_URL=sqlite:///./learning_os.db
# 若改用 PostgreSQL，把上面一行换成：
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=p2learning
POSTGRES_USER=p2user
POSTGRES_PASSWORD=
# 从旧 SQLite 库迁移时的源库路径，可留空
SQLITE_SOURCE_URL=

# ---------- 前端 ----------
# 留空表示走同源 /api
VITE_API_BASE_URL=

# ---------- 媒体库路径 ----------
# 指向你存放课程视频的目录，程序会扫描它并生成后续产物
VIDEO_FOLDER=
WORK_DIR=
OUTPUT_DIR=
THUMBNAIL_DIR=
SPRITE_DIR=

# ---------- 本地 LLM（Ollama / LM Studio）----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-4b
ASSISTANT_LLM_PROVIDER=openai

# ---------- 外部 LLM（可选，用于字幕纠错与助理）----------
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_THINKING=false
EXTERNAL_LLM_TIMEOUT_S=120
LLM_CONTEXT_TOKEN_LIMIT=8192

# ---------- 向量检索 ----------
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-bge-m3@q8_0
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=256
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MIN_TEXT_LEN=8
RERANK_ENABLED=true
RERANK_TOP_N=20
RERANK_KEEP=6

# ---------- 语音转写 ----------
DEFAULT_WHISPER_MODEL=large-v3
DEFAULT_LANGUAGE=zh
# whisper.cpp 或 faster-whisper
WHISPER_ENGINE=whisper.cpp
# whisper.cpp 的可执行文件与模型文件路径（模型不入仓库，需自行下载）
WHISPER_CPP_EXE=
WHISPER_CPP_MODEL=
WHISPER_CPP_EXTRA_ARGS=
WHISPER_CPU_THREADS=12
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0
WHISPER_VAD_FILTER=true

# ---------- 字幕纠错 ----------
SUBTITLE_CORRECTION_ENABLED=true
SUBTITLE_CORRECTION_BATCH_SIZE=60
SUBTITLE_CORRECTION_TIMEOUT_S=180

# ---------- 缓存与鉴权 ----------
REDIS_URL=redis://localhost:6379/0
# 上线前务必换成强随机值
JWT_SECRET=
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5002,http://localhost:5173,http://localhost:12302

# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，切勿提交密钥

# ==================== 数据库 ====================
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/p2learning
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=p2learning
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
# 迁移来源，只读保留用于回滚
SQLITE_SOURCE_URL=sqlite:///C:/SiteYeb/learning_os.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== 路径 ====================
VITE_API_BASE_URL=
VIDEO_FOLDER=D:/ITJC
WORK_DIR=
OUTPUT_DIR=
THUMBNAIL_DIR=
SPRITE_DIR=

# ==================== 本地 LLM ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen3-4b
ASSISTANT_LLM_PROVIDER=openai

# ==================== 外部 LLM ====================
EXTERNAL_LLM_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
EXTERNAL_LLM_API_KEY=sk-REPLACE_ME
EXTERNAL_LLM_MODEL=deepseek-v4.1-flash-1017
# 关闭思考链：实测 0.4s，开启则 57s
EXTERNAL_LLM_THINKING=false
EXTERNAL_LLM_TIMEOUT_S=120
LLM_USAGE_POLICY=external_first
LLM_CONTEXT_TOKEN_LIMIT=32000

# ==================== 向量与重排 ====================
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3@q8_0
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=256
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MIN_TEXT_LEN=8
RERANK_ENABLED=true
RERANK_TOP_N=20
RERANK_KEEP=6

# ==================== Whisper ====================
DEFAULT_WHISPER_MODEL=large-v3
DEFAULT_LANGUAGE=zh
WHISPER_ENGINE=whisper.cpp
WHISPER_CPP_EXE=
WHISPER_CPP_MODEL=
WHISPER_CPU_THREADS=8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0
WHISPER_VAD_FILTER=true
SUBTITLE_CORRECTION_ENABLED=false
SUBTITLE_CORRECTION_BATCH_SIZE=60
SUBTITLE_CORRECTION_TIMEOUT_S=180

# ==================== 队列 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== 安全 ====================
# 长度 >= 32，生产必须替换
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_EXPIRE_HOURS=24
# 逗号分隔；禁止使用 *
CORS_ORIGINS=http://localhost:5002,http://localhost:5173,http://localhost

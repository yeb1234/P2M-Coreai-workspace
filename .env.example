# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，切勿提交密钥

# ==================== 数据库 ====================
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/p2learning
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=p2learning
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
# 迁移来源，只读保留用于回滚
SQLITE_SOURCE_URL=sqlite:///C:/SiteYeb/learning_os.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== 路径 ====================
VITE_API_BASE_URL=
VIDEO_FOLDER=D:/ITJC
WORK_DIR=
OUTPUT_DIR=
THUMBNAIL_DIR=
SPRITE_DIR=

# ==================== 本地 LLM ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen3-4b
ASSISTANT_LLM_PROVIDER=openai

# ==================== 外部 LLM ====================
EXTERNAL_LLM_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
EXTERNAL_LLM_API_KEY=sk-REPLACE_ME
EXTERNAL_LLM_MODEL=deepseek-v4.1-flash-1017
# 关闭思考链：实测 0.4s，开启则 57s
EXTERNAL_LLM_THINKING=false
EXTERNAL_LLM_TIMEOUT_S=120
LLM_USAGE_POLICY=external_first
LLM_CONTEXT_TOKEN_LIMIT=32000

# ==================== 向量与重排 ====================
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3@q8_0
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=256
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MIN_TEXT_LEN=8
RERANK_ENABLED=true
RERANK_TOP_N=20
RERANK_KEEP=6

# ==================== Whisper ====================
DEFAULT_WHISPER_MODEL=large-v3
DEFAULT_LANGUAGE=zh
WHISPER_ENGINE=whisper.cpp
WHISPER_CPP_EXE=
WHISPER_CPP_MODEL=
WHISPER_CPU_THREADS=8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0
WHISPER_VAD_FILTER=true
SUBTITLE_CORRECTION_ENABLED=false
SUBTITLE_CORRECTION_BATCH_SIZE=60
SUBTITLE_CORRECTION_TIMEOUT_S=180

# ==================== 队列 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== 安全 ====================
# 长度 >= 32，生产必须替换。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
# 访问令牌有效期。改密码会立即作废所有已签发令牌，不依赖这个时间
JWT_EXPIRE_HOURS=12
# 逗号分隔；禁止使用 *
CORS_ORIGINS=http://localhost:5002,http://localhost:5173,http://localhost

# 注册开关。首台机器可用 true 注册自己的账号，之后建议改 false，
# 后续账号走「管理员在设置里开通」。公网部署务必 false。
ALLOW_REGISTRATION=true
# 逗号分隔的 username 白名单，命中即以管理员身份注册。
# 留空时，系统会把最早创建的非占位账号设成管理员（升级兼容路径）。
ADMIN_USERNAMES=
# 是否暴露 /api/docs 与 /api/openapi.json。生产保持 false ——
# 接口文档会把内部端点和参数结构完整交出去
ENABLE_DOCS=false

# 会话 Cookie。令牌放在 httpOnly Cookie 里，JS 读不到，XSS 也偷不走。
# COOKIE_SECURE 在 HTTPS 部署时必须改 true（否则浏览器不发 Cookie，
# 本地 http 调试则必须 false，两者互斥）
COOKIE_SECURE=false
SESSION_COOKIE_NAME=p2m_session
COOKIE_SAMESITE=lax

# ==================== Docker 编排 ====================
# 对外 Web 端口（改成 8080 可避免占用 80）
WEB_PORT=80
REDIS_PORT=6379
# 视频库在宿主机上的路径，会以只读方式挂进容器
VIDEO_HOST_PATH=D:/ITJC
# 容器内不能用 localhost 访问宿主机服务，compose 里已注入 host.docker.internal
EMBEDDING_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
OPENAI_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# 首次启动从 SQLite 导入业务数据：把旧库放进 ./.migration 并设为 true
MIGRATE_SQLITE=false
SQLITE_SOURCE_DIR=./.migration
# 全量向量回填（约 6 小时），放后台跑
BACKFILL_EMBEDDINGS=false
# GPU 转写：需要 NVIDIA 驱动，配合 docker-compose.gpu.yml 使用
INSTALL_CUDA=false
# 国内构建加速
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

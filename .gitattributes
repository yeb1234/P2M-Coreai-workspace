# 容器内执行的脚本必须是 LF，否则会报 "no such file or directory"
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf

# nginx 配置会被 COPY 进容器，保持 LF 避免解析异常
*.conf      text eol=lf

# Windows 批处理必须是 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.db        binary
